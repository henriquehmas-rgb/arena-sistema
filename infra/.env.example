# Copiar para infra/.env (NUNCA commitar o .env real — só este .example).
# Gerar segredos com: openssl rand -hex 32

# --- Postgres (usado pelo serviço `postgres` e montado em DATABASE_URL pelo compose) ---
POSTGRES_PASSWORD=troque-esta-senha

# --- backend/app/config.py — Settings ---

# String completa de conexão assíncrona com o Postgres. Dentro do compose o
# valor real é sobrescrito por `environment:` no serviço `api` (usa o nome
# do serviço `postgres`, não localhost) — esta linha vale para rodar o
# backend fora de container (ex.: `uvicorn` local apontando pro Postgres do
# compose exposto em localhost:5432).
DATABASE_URL=postgresql+asyncpg://arena:troque-esta-senha@localhost:5432/arena

# Redis (idem acima: dentro do compose o serviço `api` sobrescreve para
# redis://redis:6379/0).
REDIS_URL=redis://localhost:6379/0

# Segredo usado para assinar/validar JWT (access e refresh tokens).
JWT_SECRET=dev-inseguro-trocar

# Validade do access token, em minutos.
JWT_ACCESS_MIN=15

# Validade do refresh token, em dias.
JWT_REFRESH_DIAS=30

# TTL (minutos) de uma reserva pendente antes de expirar automaticamente.
RESERVA_TTL_MIN=15

# Prazo (horas) antes do horário da reserva até quando o cancelamento ainda
# gera estorno.
CANCELAMENTO_HORAS=24

# Janela de reserva online — quantos dias à frente cada tipo de recurso
# pode ser reservado.
JANELA_CAMPO_DIAS=14
JANELA_QUIOSQUE_DIAS=60

# Modo de operação do Pagar.me: simulado|sandbox|producao.
# Em `simulado`, todo o código de pagamento funciona sem chave real.
PAGARME_MODE=simulado
PAGARME_API_KEY=
PAGARME_WEBHOOK_SECRET=

# SMTP para envio de e-mails transacionais (recuperação de senha, etc.).
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# URL pública do frontend (usada em CORS e em links de e-mail).
FRONTEND_URL=http://localhost:3000

# Fuso horário de exibição (o banco sempre guarda timestamptz em UTC).
TZ_LOCAL=America/Cuiaba

# --- frontend (build arg do docker-compose, ver infra/docker-compose.yml) ---
# Base da API que o Next.js embute no bundle em build time.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
